# =============================================================================
# KEY DYNAMICS SOLUTIONS - RECRUITMENT TRACKER CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE ENGINE CONFIGURATION (MySQL or SQLite)
# -----------------------------------------------------------------------------
# Set DB_ENGINE=mysql to enable MySQL Database.
# If omitted or set to 'sqlite', it automatically uses local SQLite.
DB_ENGINE=mysql

# MySQL Connection Details (Works with Local MySQL, XAMPP, or Cloud MySQL like Azure/AWS)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=recruitment_tracker

# Alternatively, you can use a single DATABASE_URL connection string:
# DATABASE_URL=mysql://root:password@localhost:3306/recruitment_tracker?charset=utf8mb4

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
SECRET_KEY=keydynamics_corporate_recruitment_portal_jwt_secret_2026
TOKEN_MAX_AGE=604800
